{
  "rewrites": [
    { "source": "/ai/:token", "destination": "https://redesign-life-os-ui.vercel.app/api/ai/:token?sections=arbor,workouts" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
